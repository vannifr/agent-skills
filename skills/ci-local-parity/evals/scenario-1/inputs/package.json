    "test": "node --test src/**/*.test.js",
    "test:coverage": "c8 node --test src/**/*.test.js",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "c8": "^10.1.2",
    "eslint": "^9.0.0"
  }
}
